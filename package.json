{
  "name": "@ni-c/smtp-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.ni-c/smtp-mcp",
  "description": "MCP server that sends mail over SMTP, gated behind an allowlist and a human confirmation",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "smtp",
    "email",
    "mail",
    "nodemailer",
    "send"
  ],
  "license": "MIT",
  "author": "Willi Thiel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ni-c/smtp-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ni-c/smtp-mcp/issues"
  },
  "homepage": "https://smtp-mcp.ni-c.de",
  "funding": "https://github.com/sponsors/ni-c",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "smtp-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "npm run lint && npm run build && npm test",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "assets": "svg-asset-set",
    "assets:check": "svg-asset-set --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "mcp-approval": "^0.6.0",
    "mcp-internal-hosts": "^0.2.0",
    "mcp-tool-allowlist": "^0.2.0",
    "nodemailer": "^9.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "svg-asset-set": "https://github.com/ni-c/svg-asset-set/releases/download/v0.1.0/svg-asset-set-0.1.0.tgz",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
